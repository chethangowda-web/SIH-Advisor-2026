# LLM Provider: "featherless" (default) or "openrouter"
LLM_PROVIDER=featherless

# Featherless AI Config
FEATHERLESS_API_KEY=your_featherless_api_key_here
FEATHERLESS_MODEL=Qwen/Qwen3-32B

# OpenRouter Config (used when LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
CHAT_MODEL=google/gemma-4-26b-a4b-it:free

# Embedding Config
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ChromaDB Config
CHROMA_DB_PATH=./chroma_db

# Data Config
DATA_PATH=./data/sih_winners.json

# Server Config
PORT=8000